default: lint format check test

# Install dependencies
install:
    uv sync --locked

install-dev:
    uv sync --locked --dev

# Run linting checks
lint:
    uv run --locked ruff check src tests .github/scripts benchmarks

# Format code
format:
    uv run --locked ruff check --select I --fix src tests .github/scripts benchmarks
    uv run --locked ruff format src tests .github/scripts benchmarks

# Verify formatting without rewriting files (used by CI)
fmt-check:
    uv run --locked ruff format --check src tests .github/scripts benchmarks

# Run type checking
check:
    uv run --locked ty check src tests

# Run tests (fast default: slow tests skipped, 30 hypothesis examples)
test:
    uv run --locked pytest tests

# Run every test the way CI does: slow tests included, thorough hypothesis profile
test-all:
    RUN_SLOW=1 HYPOTHESIS_PROFILE=thorough uv run --locked pytest tests

# Run tests once, emitting both coverage XML and JUnit XML for Codecov
test-cov:
    RUN_SLOW=1 HYPOTHESIS_PROFILE=thorough uv run --locked pytest tests --cov=src/spxtacular --cov-report=xml --junit-xml=junit.xml

# Build and serve docs
docs:
    uv run --locked mkdocs serve --dev-addr=localhost:8003

# Build docs to site/
docs-build:
    uv run --locked mkdocs build --strict

# Report deconvolution reference accuracy and performance
benchmark:
    uv run --locked python benchmarks/deconvolution.py

# Fetch the two fonts the graphical abstract is set in. Both are SIL OFL and are
# downloaded from a pinned release rather than committed; the checksums are the
# releases' own zips, so a changed file stops the build instead of restyling the figure.
paper-fonts:
    #!/usr/bin/env bash
    set -euo pipefail
    cd paper/abstract
    mkdir -p fonts
    fetch() {
        url="$1"; zip="fonts/$2"; want="$3"; dest="fonts/$4"
        if [ ! -f "$zip" ]; then
            curl -sSLf -o "$zip" "$url"
        fi
        got="$(sha256sum "$zip" | cut -d' ' -f1)"
        if [ "$got" != "$want" ]; then
            echo "$zip: sha256 $got, expected $want" >&2
            exit 1
        fi
        rm -rf "$dest"
        unzip -q "$zip" -d "$dest"
    }
    fetch https://github.com/rsms/inter/releases/download/v4.0/Inter-4.0.zip \
        inter.zip ff970a5d4561a04f102a7cb781adbd6ac4e9b6c460914c7a101f15acb7f7d1a4 i
    fetch https://github.com/JetBrains/JetBrainsMono/releases/download/v2.304/JetBrainsMono-2.304.zip \
        jbm.zip 6f6376c6ed2960ea8a963cd7387ec9d76e3f629125bc33d1fdcd7eb7012f7bbf j

# Draw the graphical abstract from the cached pipeline output in paper/abstract/data
paper-figure: paper-fonts
    uv run --locked python paper/abstract/draw.py paper/figures/graphical_abstract

# Re-run the real pipeline and refresh paper/abstract/data/stages.json. Needs network:
# it fetches two public spectra by USI. The figure's numbers come from this file, so
# running it is how they change; paper-figure alone never touches them.
paper-data:
    uv run --locked python paper/abstract/compute.py paper/abstract/data

# Compile paper/paper.md with the official JOSS/Inara toolchain
paper-build:
    docker run --rm --volume "$PWD/paper:/data" --user "$(id -u):$(id -g)" --env JOURNAL=joss openjournals/inara

# Regenerate the figure and compile the JOSS draft
paper: paper-figure paper-build

# Count manuscript words using Pandoc from the same Inara image
paper-wordcount:
    @docker run --rm --volume "$PWD/paper:/data" --user "$(id -u):$(id -g)" --entrypoint pandoc openjournals/inara paper.md --from markdown --to plain | wc -w

# Show metadata for the latest generated JOSS PDF
paper-info:
    pdfinfo paper/paper.pdf

# Build and perform lightweight checks on the submission artifacts
paper-preflight: paper
    #!/usr/bin/env bash
    set -euo pipefail
    test -s paper/paper.pdf
    test -s paper/paper.bib
    test -s paper/abstract/draw.py
    test -s paper/abstract/data/stages.json
    test -s paper/figures/graphical_abstract.png
    test paper/figures/graphical_abstract.png -nt paper/abstract/data/stages.json
    # The committed figure must be the one draw.py produces from the committed
    # stages.json, so a hand-edited PNG or a stale redraw cannot reach the paper.
    redrawn="$(mktemp -d)"
    trap 'rm -rf "$redrawn"' EXIT
    uv run --locked python paper/abstract/draw.py "$redrawn/graphical_abstract"
    cmp paper/figures/graphical_abstract.png "$redrawn/graphical_abstract.png"
    just paper-wordcount
    pdfinfo paper/paper.pdf | sed -n '1,18p'

# Remove files generated by Inara; manuscript sources and figures are preserved
paper-clean:
    rm -f paper/paper.pdf
    rm -rf paper/jats

# --- release (standard tacular-omics recipes; canonical copy in the workspace templates/) ---

# Set the version everywhere and date the [Unreleased] changelog section
set-version version:
    python scripts/release_version.py sync --set {{version}}

# Copy __version__ to CITATION.cff after editing it by hand
sync-version:
    python scripts/release_version.py sync

# Fail if version metadata disagrees
check-version:
    python scripts/release_version.py check
