{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tacular-omics.github.io/spxtacular/schemas/chromatogram-v1.schema.json",
  "title": "Spxtacular Chromatogram v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "kind", "arrays", "metadata"],
  "properties": {
    "schema": {"const": "spxtacular.chromatogram"},
    "schema_version": {"const": 1},
    "kind": {"const": "chromatogram"},
    "arrays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rt", "intensity"],
      "properties": {
        "rt": {"type": "array", "items": {"type": "number"}},
        "intensity": {"type": "array", "items": {"type": "number"}}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "mz", "tolerance", "tolerance_type", "meta"],
      "properties": {
        "label": {"type": "string"},
        "mz": {"type": ["number", "null"]},
        "tolerance": {"type": ["number", "null"]},
        "tolerance_type": {"type": ["string", "null"]},
        "meta": {"type": "object"}
      }
    }
  }
}
